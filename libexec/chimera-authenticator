#!/usr/bin/env python
import sys
import pygame


class Color:
    TEXT = (252, 252, 252)
    BACKGROUND = (15, 47, 78)


# Load the password from the command line arguments
if len(sys.argv) > 1:
    password = sys.argv[1]
else:
    print("No password to show specified")
    exit(1)

pygame.init()

# Initialize window
screen = pygame.display.set_mode((0, 0), pygame.FULLSCREEN)
width, height = screen.get_size()

font_size = width // 20

# Try to load DejaVu Sans, fall back to default
try:
    password_font = pygame.font.SysFont("dejavusans", font_size, bold=True)
    label_font = pygame.font.SysFont("dejavusans", font_size // 2)
except:
    password_font = pygame.font.Font(None, font_size)
    label_font = pygame.font.Font(None, font_size // 2)

# Pre-render text surfaces
instructions_surf = label_font.render("Your password for the web interface is:", True, Color.TEXT)
password_surf = password_font.render(password, True, Color.TEXT)
quit_surf = label_font.render("Press any button or ESC to exit this screen", True, Color.TEXT)

# Center positions
instructions_rect = instructions_surf.get_rect(centerx=width // 2, centery=height - font_size)
password_rect = password_surf.get_rect(centerx=width // 2, centery=height // 2)
quit_rect = quit_surf.get_rect(centerx=width // 2, centery=font_size)

# Setup joystick
pygame.joystick.init()
joysticks = [pygame.joystick.Joystick(i) for i in range(pygame.joystick.get_count())]
for joystick in joysticks:
    joystick.init()


def main():
    clock = pygame.time.Clock()
    running = True

    while running:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    running = False
            elif event.type == pygame.MOUSEBUTTONDOWN:
                running = False
            elif event.type == pygame.JOYBUTTONDOWN:
                running = False

        screen.fill(Color.BACKGROUND)
        screen.blit(instructions_surf, instructions_rect)
        screen.blit(password_surf, password_rect)
        screen.blit(quit_surf, quit_rect)
        pygame.display.flip()
        clock.tick(30)

    pygame.quit()


if __name__ == "__main__":
    main()
