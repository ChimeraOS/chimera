#!/usr/bin/env python
import argparse
import pygame
import os.path
from chimera_app.config import RESOURCE_DIR
from chimera_app.config import SETTINGS_DIR

PIPE_FILE=str()

pygame.init()

screen = pygame.display.set_mode((0, 0), pygame.FULLSCREEN)
width, height = screen.get_size()

text_size = int(height // 24)
font = pygame.font.SysFont('dejavusans', text_size)

custom_image_path = os.path.join(SETTINGS_DIR, 'splash.png')
if os.path.exists(custom_image_path):
    background_image_path = custom_image_path
else:
    background_image_path = os.path.join(RESOURCE_DIR, 'images', 'splash', 'chimeraos_logo.png')

background_image = pygame.image.load(background_image_path).convert_alpha()

# Center and scale to screen
scale = 0.4 * height / background_image.get_height()
background_image = pygame.transform.smoothscale_by(background_image, scale)
background_rect = background_image.get_rect(center=(width // 2, height // 2))


def read_label():
    with open(PIPE_FILE, 'r', encoding='utf-8') as message_file:
        return message_file.readlines()[-1].strip()


def arg_parse():
    parser = argparse.ArgumentParser(description="Simple ChimeraOS splash screen")
    parser.add_argument("-p", "--pipe-file",
                        action='store',
                        type=str,
                        help="Pipe file to check percentage"
                       )
    return parser.parse_args()


def main():
    global PIPE_FILE

    args = arg_parse()
    if args.pipe_file:
        PIPE_FILE = args.pipe_file

    clock = pygame.time.Clock()

    running = True
    while running:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

        screen.fill((0, 0, 0))
        screen.blit(background_image, background_rect)

        if PIPE_FILE:
            text = read_label()
            label_surface = font.render(text, True, (255, 255, 255))
            label_rect = label_surface.get_rect(center=(width // 2, height - text_size * 4))
            screen.blit(label_surface, label_rect)

        pygame.display.flip()
        clock.tick(30)

    pygame.quit()


if __name__ == "__main__":
    main()
